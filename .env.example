# ─────────────────────────────────────────────────────────────────
#  Smart City Traffic Analytics — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL (optional – app runs in CSV-only mode if omitted) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_city_traffic
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── Google Gemini API (optional – falls back to rule-based insights) ──
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenAI (alternative to Gemini – optional) ──
OPENAI_API_KEY=

# ── App Settings ──
APP_ENV=development
LOG_LEVEL=INFO

# ── Data Paths ──
RAW_DATA_PATH=c:\Users\prade\Downloads\pms.csv\compressed_data.csv
CLEANED_DATA_PATH=data/PEMS_BAY_cleaned_long.csv
